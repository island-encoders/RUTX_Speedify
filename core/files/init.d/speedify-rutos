#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=01
ROOT=/usr/local/speedify-rutos

start_service() {
    [ "$(uci -q get speedify_rutos.core.enabled)" = 1 ] || return 0
    [ "$(uci -q get speedify_rutos.core.network_ready)" = 1 ] || { logger -t speedify-rutos 'Network setup has not been acknowledged'; return 1; }
    "$ROOT/bin/init-xtables" || return 1
    "$ROOT/bin/load-kmods" || return 1
    "$ROOT/bin/check-platform" || return 1
    "$ROOT/bin/check-runtime" || return 1
    available=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
    [ "${available:-0}" -ge 32768 ] || { logger -t speedify-rutos 'Less than 32 MiB available RAM'; return 1; }
    umask 077
    mkdir -p /etc/speedify-rutos/state /etc/speedify-rutos/keys /tmp/speedify-rutos-logs
    ifup sfyrut || return 1
    procd_open_instance
    procd_set_param command "$ROOT/bin/run-speedify" daemon -d /etc/speedify-rutos/state -r "$ROOT/runtime" -g /tmp/speedify-rutos-logs -k /etc/speedify-rutos/keys
    procd_set_param respawn 60 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    ifdown sfyrut 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger speedify_rutos
}
