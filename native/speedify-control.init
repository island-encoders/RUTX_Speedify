#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=02
start_service() {
 R=/usr/local/speedify-rutos
 "$R/bin/init-xtables" && "$R/bin/load-kmods" && "$R/bin/check-platform" || return 1
 /usr/local/speedify-native/safe-start || return 1
 mkdir -p /tmp/speedify-rutos-logs
 procd_open_instance
    procd_set_param command /usr/local/speedify-native/run-daemon -d /etc/speedify-rutos/state -r "$R/runtime" -g /tmp/speedify-rutos-logs -k /etc/speedify-rutos/keys
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
